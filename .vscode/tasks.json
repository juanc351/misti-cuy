{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start Development Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting.*|.*Ready.*|.*ready.*",
          "endsPattern": ".*Ready.*|.*ready.*|.*compiled successfully.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "🏗️ Build Project",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "🧹 Run ESLint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "test"
    },
    {
      "label": "🔍 Type Check",
      "type": "shell",
      "command": "npx",
      "args": ["tsc", "--noEmit"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "test"
    },
    {
      "label": "✅ Full Project Check",
      "dependsOrder": "sequence",
      "dependsOn": [
        "🔍 Type Check",
        "🧹 Run ESLint",
        "🏗️ Build Project"
      ],
      "group": "test"
    }
  ]
}